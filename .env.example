# Copy this file to .env, fill in the values, then run:
#   docker compose up --build --abort-on-container-exit --exit-code-from harness
#
# MODEL/API_KEY/BASE_URL are provided in the hackathon API-key email.
# Leave MODEL=mock/solver to try the whole flow offline with no API key.
# Other offline models: mock/idle (submits immediately), mock/allow_all,
# mock/deny_all.
MODEL=gpt-luna
API_KEY=
BASE_URL=

# full      = gate TASK_ID, then run the model on TASK_ID (default)
# all       = gate every task, then run the model on every task
# baselines = gate every task, no model call
TASK_ID=med_01
SEED=0
MODE=full

# Optional: extra instructions appended to the system prompt, verbatim.
# Put the file in inputs/ and use a path like inputs/extra.txt.
# Empty = use inputs/append.txt if it exists. An explicitly named missing or
# empty file stops the run with exit code 3.
APPEND_FILE=

# Optional: cap each model reply. Empty = provider default.
MAX_TOKENS=

# Optional: harness limits.
MAX_STEPS=40
MAX_SECONDS=600
